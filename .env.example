# ============================================================================
# ASPG environment. Copy to .env.local. Real values go in the team group chat.
# .env.local is git-ignored. Never commit a key. Testnet keys only.
# ============================================================================

# --- CORE owns ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- PAY owns --- Algorand TestNet is the only rail.
AVM_PRIVATE_KEY=""                        # base64 of the 64-byte TESTNET key, from algo-keygen.mjs
X402_FACILITATOR_URL="https://facilitator.goplausible.xyz"
ALGORAND_ALGOD_URL="https://testnet-api.algonode.cloud"   # optional; blank uses the SDK default
GUARD_HMAC_SECRET="dev-only-change-me"    # signs the allowToken

# --- DEMO owns ---
MERCHANT_ALGORAND_ADDRESS=""              # 58-char base32, opted in to ASA 10458941
AGENT_ALGORAND_ADDRESS=""                 # the buyer address, shown on the dashboard agent card
ROGUE_ALGORAND_ADDRESS=""                 # drill D4 only; never funded, never opted in
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional, non-decisional (CORE) ---
GROQ_API_KEY=""                           # NL -> policy draft + explanations only

# --- Local switches ---
USE_MOCKS="0"                             # 1 = use every owner's mock/ instead of the real module

# ============================================================================
# Vercel only. Do not set these locally.
# ============================================================================
# CRON_SECRET=""                          # Vercel sends it as Bearer on /api/v1/cron/sweep.
#                                         # Unset leaves the sweep open to anyone.
#
# NEXT_PUBLIC_APP_URL must be the real deployment origin. DEMO calls it back over HTTP from inside
# the function, so a leftover localhost value fails as a refused connection, not as a config error.
# Left unset on Vercel, the code falls back to VERCEL_PROJECT_PRODUCTION_URL.
#
# DATABASE_URL must be the POOLED connection string (Supabase: port 6543, "Transaction" mode).
# The direct 5432 string runs out of connections once more than a few functions are warm.

