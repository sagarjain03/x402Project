{
  "name": "x402project",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Spend Policy Guard - policy-enforcement gateway for x402 autonomous payments",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local src/core/db/seed.ts",
    "db:reset": "npm run db:push -- --force && npm run db:seed",
    "poc:x402": "tsx --env-file=.env.local src/payments/scripts/poc-x402.ts",
    "bench": "tsx --env-file=.env.local src/core/scripts/bench-evaluate.ts",
    "sim": "tsx --env-file=.env.local src/demo/simulator/index.ts",
    "agent": "tsx --env-file=.env.local src/demo/agent/run.ts",
    "drills": "tsx --env-file=.env.local src/demo/drills/index.ts",
    "docs:pdf": "node ../Docs/tools/md2pdf.js ../Docs/PRD.md ../Docs/ARCHITECTURE.md ../Docs/API_DOCS.md ../Docs/DEVELOPMENT_PLAN.md ../Docs/REPO_STRUCTURE.md",
    "wallet:check": "node src/payments/scripts/algo-check.mjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.28",
    "@base-ui/react": "^1.7.0",
    "@x402/avm": "2.22.0",
    "@x402/fetch": "2.22.0",
    "@x402/next": "2.22.0",
    "ai": "^7.0.66",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.4",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.469.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.0",
    "shadcn": "^4.18.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "algosdk": "^3.6.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "_installNotes": {
    "x402": "PAY installs these in Phase 0 after pinning the real versions: pnpm add @x402/fetch @x402/evm @x402/next",
    "llm": "DEMO installs these in Phase 4c, only for the prompt-injection demo: pnpm add ai @ai-sdk/groq",
    "ui": "UI runs `npx shadcn@latest init` once, then adds components on demand"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
