{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/shared/*": [
        "./src/shared/*"
      ],
      "@/payments/*": [
        "./src/payments/*"
      ],
      "@/core": [
        "./src/core/index.ts"
      ],
      "@/core/*": [
        "./src/core/*"
      ],
      "@/dashboard/*": [
        "./src/dashboard/*"
      ],
      "@/demo/*": [
        "./src/demo/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}